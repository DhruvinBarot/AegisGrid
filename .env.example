# Copy to .env (git-ignored). Needed only for running tooling on the host; compose sets its own values.
# Placeholders only. Never put real credentials in this file.

# Host ports published by docker compose (5433 avoids clashing with a locally installed Postgres)
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# Required, no default.
AEGIS_ENV=development

AEGIS_REDIS_URL=redis://127.0.0.1:6379/0

# Optional in development and test: the app has built-in local defaults for these.
# Staging and production must set real values and refuse to start without them. See the README.
# AEGIS_DATABASE_URL=postgresql+psycopg://aegis_api:CHANGE_ME@127.0.0.1:5433/aegisgrid
# AEGIS_SIGNING_KEY_PASSPHRASE=CHANGE_ME
# AEGIS_API_KEY_PEPPER=CHANGE_ME
